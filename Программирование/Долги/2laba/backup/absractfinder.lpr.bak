{$mode objfpc}
{$H+}
program AbstractFinderDemo;

uses
  SysUtils,
  heaptrc;

type
  TDataArray = array of integer;
  TIndexArray = array of integer;

  TCompareFunc = function(A, B: integer): integer;

  { TAbstractFinder }

  TAbstractFinder = class
  protected
    FData: TDataArray;
    FTarget: integer;
    //Метод сравнения
    FCompFunc: TCompareFunc;

    class function DefaultCompare(A, B: integer): integer; static;

  public
    constructor Create(const AData: array of integer); virtual;
    destructor Destroy; override;

    function DoFindOne: integer; virtual; abstract;
    function DoFindAll: TIndexArray; virtual; abstract;

    procedure ChangeData(const NewData: array of integer);
    procedure SetCompareMethod(AFunc: TCompareFunc);

    function IsValid: boolean; virtual; abstract;

    function FindOne(Value: integer): integer; overload;
    function FindOne(Value: integer; AFunc: TCompareFunc): integer; overload;

    function FindAll(Value: integer): TIndexArray; overload;
    function FindAll(Value: integer; AFunc: TCompareFunc): TIndexArray; overload;
  end;

  { TLineFinder }

  TLineFinder = class(TAbstractFinder)
  protected

  public
    function DoFindOne: integer; override;
    function DoFindAll: TIndexArray; override;
    function IsValid: boolean; override;
  end;

  { TBinFinder }

  TBinFinder = class(TAbstractFinder)
  protected

  public
    function DoFindOne: integer; override;
    function DoFindAll: TIndexArray; override;
    constructor Create(const AData: array of integer); override;
    function IsValid: boolean; override;
  end;

  {---------------TAbstractFinder----------------}

  //просто сравнение чисел
  class function TAbstractFinder.DefaultCompare(A, B: integer): integer;
  begin
    if A < B then
      Result := -1
    else
    if A > B then
      Result := 1
    else
      Result := 0;
  end;


  //Консруктор
  constructor TAbstractFinder.Create(const AData: array of integer);
  begin
    inherited Create;
    FCompFunc := @DefaultCompare;
    ChangeData(AData); //Копируем переданный массив в FData
  end;

  //обычный декструктор
  destructor TAbstractFinder.Destroy;
  begin
    SetLength(FData, 0);
    inherited Destroy;
  end;

  //Замена данных. Просто заменяем массив новыми данными
  procedure TAbstractFinder.ChangeData(const NewData: array of integer);
  var
    I: integer;
  begin
    SetLength(FData, Length(NewData));

    for I := 0 to High(NewData) do
      FData[I] := NewData[I];
  end;


  //Устанавливаем метод сравнения
  procedure TAbstractFinder.SetCompareMethod(AFunc: TCompareFunc);
  begin
    if Assigned(AFunc) then
      FCompFunc := AFunc
    else
      FCompFunc := @DefaultCompare;
  end;

  //Поиск одного жэлемента
  function TAbstractFinder.FindOne(Value: integer): integer;
  begin
    FTarget := Value;

    if Length(FData) = 0 then
      Exit(-1);

    Result := DoFindOne;
  end;


  //Поиск с функцией сравнения
  function TAbstractFinder.FindOne(Value: integer; AFunc: TCompareFunc): integer;
  var
    OldFunc: TCompareFunc;
  begin
    OldFunc := FCompFunc;
    SetCompareMethod(AFunc);

    Result := FindOne(Value);

    FCompFunc := OldFunc;
  end;

  //Поиск всех совпадений
  function TAbstractFinder.FindAll(Value: integer): TIndexArray;
  begin
    FTarget := Value;

    if Length(FData) = 0 then
    begin
      SetLength(Result, 0);
      Exit;
    end;

    Result := DoFindAll;
  end;

  //Поиск всех со сравнением
  function TAbstractFinder.FindAll(Value: integer; AFunc: TCompareFunc): TIndexArray;
  var
    OldFunc: TCompareFunc;
  begin
    OldFunc := FCompFunc;
    SetCompareMethod(AFunc);

    Result := FindAll(Value);

    FCompFunc := OldFunc;
  end;

  { ----------------TLineFinder---------------- }

  function TLineFinder.IsValid: boolean;
  begin
    Result := True;
  end;

  //Линейный поиск и сравнение. с результатом
  function TLineFinder.DoFindOne: integer;
  var
    I: integer;
  begin
    Result := -1;

    for I := 0 to High(FData) do
      if FCompFunc(FData[I], FTarget) = 0 then
        Exit(I);
  end;

  //Ищем все совпадения линейно, если нашли, то сохраняем индекс и увеличиваем счетчик
  function TLineFinder.DoFindAll: TIndexArray;
  var
    I, Count: integer;
  begin
    SetLength(Result, Length(FData));

    Count := 0;

    for I := 0 to High(FData) do
      if FCompFunc(FData[I], FTarget) = 0 then
      begin
        Result[Count] := I;
        Inc(Count);
      end;

    SetLength(Result, Count);
  end;

  {-------------TBinFinder-------------}

  //конструктор, но еще проверяем на сортировку массива
  constructor TBinFinder.Create(const AData: array of integer);
  begin
    inherited Create(AData);

    if not IsValid then
      raise Exception.Create('Для бинарного поиска массив должен быть отсортирован');
  end;

  //Проверка на валидность, 1-4-12 норм, 1-12-4 - не норм, выходим из цикла
  function TBinFinder.IsValid: boolean;
  var
    I: integer;
  begin
    Result := True;

    for I := 0 to High(FData) - 1 do
      if FCompFunc(FData[I], FData[I + 1]) > 0 then
        Exit(False);
  end;

  //Бинарный поиск и сравнение. Сравниваем найденный индекс с искомым. Если нашли то выходим
  //Если элемент меньше, получается мы можем обросить левую сторону, ведь массив отсортирован и ищем вправой
  //Тоже самое с правой частью
  function TBinFinder.DoFindOne: integer;
  var
    L, R, M, C: integer;
  begin
    Result := -1;

    L := 0;
    R := High(FData);

    while L <= R do
    begin
      M := (L + R) div 2;

      C := FCompFunc(FData[M], FTarget);

      if C = 0 then
        Exit(M);

      if C < 0 then
        L := M + 1
      else
        R := M - 1;
    end;
  end;

  //Бинарно ищем все вхождения, просто сравниваем и определяем границы. А потом линейно находим все результаты
  //и добавляем в массив
  function TBinFinder.DoFindAll: TIndexArray;
  var
    Idx, LeftPos, RightPos, I, Count: integer;
  begin
    SetLength(Result, 0);

    Idx := DoFindOne;

    if Idx = -1 then
      Exit;

    LeftPos := Idx;
    while (LeftPos > 0) and (FCompFunc(FData[LeftPos - 1], FTarget) = 0) do
      Dec(LeftPos);

    RightPos := Idx;
    while (RightPos < High(FData)) and
      (FCompFunc(FData[RightPos + 1], FTarget) = 0) do
      Inc(RightPos);

    SetLength(Result, RightPos - LeftPos + 1);

    Count := 0;
    for I := LeftPos to RightPos do
    begin
      Result[Count] := I;
      Inc(Count);
    end;
  end;

  {-------------Main--------------}

var
  F: TAbstractFinder;
  Arr: TIndexArray;
  I: integer;

begin
  Writeln('Линейный поиск:');
  F := TLineFinder.Create([1, 4, 2, 3, 2, 1, 2, 2, 1, 23, 40, 2, 2, 2, 4]);

  Writeln('FindOne(2) = ', F.FindOne(2));

  Arr := F.FindAll(3);
  Write('FindAll(2): ');
  for I := 0 to High(Arr) do
    Write(Arr[I], ' ');
  Writeln;

  F.Free;

  Writeln;
  Writeln('Бинарный поиск');

  F := TBinFinder.Create([1, 4, 12, 13, 13, 13, 21, 101]);

  Writeln('FindOne(13) = ', F.FindOne(13));

  Arr := F.FindAll(13);
  Write('FindAll(13): ');
  for I := 0 to High(Arr) do
    Write(Arr[I], ' ');
  Writeln;

  F.Free;
end.
